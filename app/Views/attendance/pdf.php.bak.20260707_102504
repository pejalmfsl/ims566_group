                <tr>
                    <td><?= esc($index + 1) ?></td>
                    <td><?= esc($participant['full_name'] ?? '-') ?></td>
                    <td><?= esc($participant['student_staff_id'] ?? '-') ?></td>
                    <td><?= esc($participant['email'] ?? '-') ?></td>
                    <td><?= esc($participant['faculty'] ?? '-') ?></td>
                    <td>Attended</td>
                </tr>
            <?php endforeach; ?>
